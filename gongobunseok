    { pattern: /mongodb/i, name: 'MongoDB', cat: 'DB', level: '중급', desc: 'NoSQL 문서형 DB' },
    { pattern: /redis/i, name: 'Redis', cat: 'DB', level: '중급', desc: '인메모리 캐시 DB' },
    { pattern: /\bsql\b/i, name: 'SQL', cat: 'DB', level: '입문', desc: '관계형 DB 쿼리 언어' },
    { pattern: /git/i, name: 'Git', cat: 'DevOps', level: '입문', desc: '버전 관리 시스템, 협업 필수' },
    { pattern: /docker/i, name: 'Docker', cat: 'DevOps', level: '중급', desc: '컨테이너 기반 개발환경 관리' },
    { pattern: /kubernetes|k8s/i, name: 'Kubernetes', cat: 'DevOps', level: '심화', desc: '컨테이너 오케스트레이션' },
    { pattern: /aws/i, name: 'AWS', cat: 'DevOps', level: '중급', desc: '아마존 클라우드 서비스' },
    { pattern: /azure/i, name: 'Azure', cat: 'DevOps', level: '중급', desc: '마이크로소프트 클라우드 서비스' },
    { pattern: /gcp|google cloud/i, name: 'GCP', cat: 'DevOps', level: '중급', desc: '구글 클라우드 서비스' },
    { pattern: /linux/i, name: 'Linux', cat: 'DevOps', level: '중급', desc: '서버 운영체제 기본' },
    { pattern: /ci\/cd|cicd|jenkins/i, name: 'CI/CD', cat: 'DevOps', level: '중급', desc: '자동화 배포 파이프라인' },
    { pattern: /tensorflow/i, name: 'TensorFlow', cat: 'AI/ML', level: '중급', desc: '구글의 딥러닝 프레임워크' },
    { pattern: /pytorch/i, name: 'PyTorch', cat: 'AI/ML', level: '중급', desc: '연구자들이 선호하는 딥러닝 프레임워크' },
    { pattern: /pandas/i, name: 'Pandas', cat: 'AI/ML', level: '입문', desc: 'Python 데이터 분석 라이브러리' },
    { pattern: /numpy/i, name: 'NumPy', cat: 'AI/ML', level: '입문', desc: 'Python 수치 계산 라이브러리' },
    { pattern: /머신러닝|machine learning/i, name: '머신러닝', cat: 'AI/ML', level: '중급', desc: '데이터 기반 예측 모델' },
    { pattern: /딥러닝|deep learning/i, name: '딥러닝', cat: 'AI/ML', level: '심화', desc: '인공신경망 기반 학습' },
    { pattern: /rest api|restful/i, name: 'REST API', cat: '기타', level: '입문', desc: '웹 서비스 통신 방식' },
    { pattern: /agile|scrum/i, name: 'Agile/Scrum', cat: '기타', level: '입문', desc: '애자일 개발 방법론' },
    { pattern: /네트워크|network/i, name: '네트워크', cat: '기타', level: '중급', desc: 'TCP/IP, HTTP 등 통신 개념' },
    { pattern: /보안|security/i, name: '보안', cat: '기타', level: '중급', desc: '사이버 보안 기초' },
    { pattern: /정보처리기사/i, name: '정보처리기사', cat: '자격증', level: '입문', desc: '국가공인 IT 기본 자격증' },
  ],
  PREFERRED_HINTS: /우대|preferred|plus|bonus|있으면 좋은/i,
  ROLE_KEYWORDS: [
    { pattern: /백엔드|back.?end|서버/i, role: '백엔드 개발' },
    { pattern: /프론트엔드|front.?end|UI/i, role: '프론트엔드 개발' },
    { pattern: /풀스택|full.?stack/i, role: '풀스택 개발' },
    { pattern: /데이터 분석|data anal/i, role: '데이터 분석' },
    { pattern: /머신러닝|AI 개발|딥러닝/i, role: 'AI/ML 엔지니어링' },
    { pattern: /임베디드|embedded/i, role: '임베디드 개발' },
    { pattern: /시스템|system.{0,6}engi/i, role: '시스템 엔지니어링' },
    { pattern: /보안|security/i, role: '보안 엔지니어링' },
    { pattern: /DevOps|SRE|인프라/i, role: 'DevOps/인프라' },
    { pattern: /모바일|android|ios|앱/i, role: '모바일 개발' },
  ],
  analyze(text) {
    const foundSkills = this.SKILL_DB.filter(s => s.pattern.test(text));
    const lines = text.split(/\n|\.|\,|。/);
    const preferredSkills = [], requiredSkills = [];
    foundSkills.forEach(skill => {
      const isPref = lines.some(line => skill.pattern.test(line) && this.PREFERRED_HINTS.test(line));
      if (isPref) preferredSkills.push(skill);
      else requiredSkills.push(skill);
    });
    const top3 = [...requiredSkills, ...preferredSkills].slice(0, 3);
    const roles = this.ROLE_KEYWORDS.filter(r => r.pattern.test(text)).map(r => r.role);
    if (!roles.length) roles.push('직무 정보 부족');
    const levelOrder = { '입문': 1, '중급': 2, '심화': 3 };
    const studyList = [...requiredSkills, ...preferredSkills]
      .sort((a, b) => levelOrder[a.level] - levelOrder[b.level])
      .map((s, i) => ({ rank: i + 1, name: s.name, level: s.level, desc: s.desc }));
    const parts = [];
    if (requiredSkills.length) parts.push(`공고 본문에서 ${requiredSkills.map(s=>s.name).join(', ')} 등이 필수 역량으로 언급되었습니다.`);
    if (preferredSkills.length) parts.push(`"우대" 조건으로 ${preferredSkills.map(s=>s.name).join(', ')}이(가) 명시되어 있습니다.`);
    const reason = parts.length ? parts.join(' ') : '공고 내용에서 구체적인 기술 키워드를 추출하지 못했습니다. 더 자세히 입력해 주세요.';
    return {
      required: requiredSkills.map(s => ({ name: s.name, cat: s.cat, level: s.level })),
      preferred: preferredSkills.map(s => ({ name: s.name, cat: s.cat, level: s.level })),
      top3: top3.map(s => s.name),
      roles, studyList, reason, totalSkills: foundSkills.length
    };
  },
  fitAnalysis(mySkills, analysis) {
    const norm = mySkills.map(s => s.trim().toLowerCase());
    const has = name => norm.some(m => m.includes(name.toLowerCase()) || name.toLowerCase().includes(m));
    const req = analysis.required.map(s => s.name);
    const pref = analysis.preferred.map(s => s.name);
    const ownedReq = req.filter(has), missingReq = req.filter(s => !has(s));
    const ownedPref = pref.filter(has);
    const reqScore = req.length ? (ownedReq.length / req.length) * 70 : 70;
    const prefScore = pref.length ? (ownedPref.length / pref.length) * 30 : 30;
    const fitRate = Math.round(reqScore + prefScore);
    return { fitRate, ownedRequired: ownedReq, missingRequired: missingReq };
  },
  calcDday(endDate) {
    const today = new Date(); today.setHours(0,0,0,0);
    return Math.ceil((new Date(endDate) - today) / 86400000);
  },
  ddayLabel(endDate) {
    const d = this.calcDday(endDate);
    if (d < 0) return `마감`;
    if (d === 0) return 'D-DAY';
    return `D-${d}`;
  },
  calcStatus(startDate, endDate) {
    const today = new Date(); today.setHours(0,0,0,0);
    if (today < new Date(startDate)) return '접수 예정';
    if (today > new Date(endDate)) return '마감';
    return '접수 중';
  }
};

/* ========== 분석 실행 ========== */
function runAnalysis() {
  const input = document.getElementById('jobInput').value.trim();
  if (!input) { showToast('분석할 내용을 입력해 주세요'); return; }

  const btn = document.getElementById('analyzeBtn');
  const btnText = document.getElementById('btnText');
  btn.disabled = true;
  btnText.innerHTML = '<span class="spinner"></span> 분석 중...';

  setTimeout(() => {
    const result = Analyzer.analyze(input);
    renderResult(result);
    btn.disabled = false;
    btnText.textContent = '🔍 분석하기';
    showToast('분석 완료! 🎉');
  }, 600);
}

function renderResult(r) {
  const el = document.getElementById('analysisResult');

  if (r.totalSkills === 0) {
    el.innerHTML = `<div class="result-empty">인식된 기술 키워드가 없습니다. Python, Java, SQL 등 기술명을 포함해 다시 입력해 보세요.</div>`;
    return;
  }

  const topHTML = r.top3.map((t, i) =>
    `<span class="tag tag-top">🏆 ${i+1}위 ${t}</span>`
  ).join('');

  const reqHTML = r.required.length
    ? r.required.map(s => `<span class="tag tag-required">${s.name}</span>`).join('')
    : '<span style="font-size:12px;color:#aaa;">없음</span>';

  const prefHTML = r.preferred.length
    ? r.preferred.map(s => `<span class="tag tag-preferred">${s.name}</span>`).join('')
    : '<span style="font-size:12px;color:#aaa;">없음</span>';

  const roleHTML = r.roles.map(ro => `<span class="tag tag-role">${ro}</span>`).join('');

  const studyRows = r.studyList.slice(0, 8).map(s => `
    <tr>
      <td>${s.rank}</td>
      <td><strong>${s.name}</strong></td>
      <td><span class="level-badge level-${s.level}">${s.level}</span></td>
      <td style="font-size:11px;color:var(--text-sub);">${s.desc}</td>
    </tr>`).join('');

  el.innerHTML = `
    <div class="result-section">
      <div class="result-section-title">⭐ 핵심 역량 TOP 3</div>
      <div class="tag-row">${topHTML}</div>
    </div>

    <div class="result-section">
      <div class="result-section-title">✅ 필수 역량</div>
      <div class="tag-row">${reqHTML}</div>
    </div>

    <div class="result-section">
      <div class="result-section-title">➕ 우대 역량</div>
      <div class="tag-row">${prefHTML}</div>
    </div>

    <div class="result-section">
      <div class="result-section-title">💼 예상 업무</div>
      <div class="tag-row">${roleHTML}</div>
    </div>

    <div class="result-section">
      <div class="result-section-title">📚 추천 학습 순서</div>
      <table class="study-table">
        <thead>
          <tr>
            <th>#</th><th>기술</th><th>난이도</th><th>설명</th>
          </tr>
        </thead>
        <tbody>${studyRows}</tbody>
      </table>
    </div>

    <div class="result-section">
      <div class="result-section-title">📝 분석 근거</div>
      <div class="reason-text">${r.reason}</div>
    </div>

    <div class="result-section">
      <div class="result-section-title">🔍 나의 적합도 분석</div>
      <div class="fit-section">
        <div class="fit-input-row">
          <input type="text" class="fit-input" id="mySkillsInput" placeholder="보유 역량 입력 (예: Python, SQL, Git)" />
          <button class="fit-btn" onclick="runFit()">분석</button>
        </div>
        <div id="fitResult"></div>
      </div>
    </div>
  `;

  // 현재 분석 결과를 전역에 저장 (적합도 분석용)
  window._lastAnalysis = r;
}

function runFit() {
  if (!window._lastAnalysis) { showToast('먼저 공고를 분석해 주세요'); return; }
  const val = document.getElementById('mySkillsInput').value.trim();
  if (!val) { showToast('보유 역량을 입력해 주세요'); return; }
  const mySkills = val.split(',').map(s => s.trim()).filter(Boolean);
  const fit = Analyzer.fitAnalysis(mySkills, window._lastAnalysis);
  const barColor = fit.fitRate >= 70 ? '#16a34a' : fit.fitRate >= 40 ? '#d97706' : '#dc2626';
  const missingHTML = fit.missingRequired.length
    ? fit.missingRequired.map(s => `<span class="tag tag-top">${s}</span>`).join('')
    : '<span style="font-size:12px;color:#16a34a;font-weight:600;">🎉 모든 필수 역량 보유!</span>';

  document.getElementById('fitResult').innerHTML = `
    <div class="fit-result">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
        <span style="font-size:13px;font-weight:700;">적합도</span>
        <span style="font-size:20px;font-weight:800;color:${barColor};">${fit.fitRate}%</span>
      </div>
      <div class="fit-bar-wrap">
        <div class="fit-bar-fill" style="width:${fit.fitRate}%;background:${barColor};"></div>
      </div>
      <div style="font-size:12px;color:var(--text-sub);margin-bottom:6px;font-weight:600;">부족 역량</div>
      <div class="tag-row">${missingHTML}</div>
    </div>`;
}

/* ========== 마이페이지 사이드 패널 렌더링 ========== */
function renderSidePanel() {
  const jobs = Storage.getJobs();
  const today = new Date(); today.setHours(0,0,0,0);

  // 마감 임박 (D-7 이내, 접수 중)
  const urgent = jobs.filter(j => {
    const d = Analyzer.calcDday(j.endDate);
    return d >= 0 && d <= 7 && Analyzer.calcStatus(j.startDate, j.endDate) === '접수 중';
  }).sort((a, b) => Analyzer.calcDday(a.endDate) - Analyzer.calcDday(b.endDate)).slice(0, 4);

  const deadlineEl = document.getElementById('deadlineList');
  if (urgent.length === 0) {
    deadlineEl.innerHTML = `
      <div class="deadline-item" style="justify-content:center;color:var(--text-sub);">
        마감 임박 공고 없음 👍
      </div>`;
  } else {
    deadlineEl.innerHTML = urgent.map(j => {
      const d = Analyzer.calcDday(j.endDate);
      const cls = d <= 2 ? 'dday-urgent' : d <= 5 ? 'dday-warn' : 'dday-safe';
      return `<div class="deadline-item">
        <span style="font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;">${j.title}</span>
        <span class="deadline-dday ${cls}">D-${d}</span>
      </div>`;
    }).join('');
  }

  // 즐겨찾기
  const favs = Storage.getFavorites().slice(0, 2);
  const favEl = document.getElementById('favList');
  if (favs.length === 0) {
    favEl.innerHTML = `<div class="fav-item" style="color:var(--text-sub);">즐겨찾기 없음</div>`;
  } else {
    favEl.innerHTML = favs.map(j => `
      <div class="fav-item">
        <span class="fav-star">⭐</span>
        <span class="fav-text">${j.title}</span>
        <span style="font-size:11px;color:var(--text-sub);">${j.company}</span>
      </div>`).join('');
  }
}

/* ========== 페이지 이동 안내 ========== */
function showPage(page) {
  showToast(`${page === 'dashboard' ? '대시보드' : page === 'list' ? '공고 목록' : page === 'register' ? '공고 등록' : page === 'calendar' ? '캘린더' : page === 'stats' ? '통계' : '공고분석'} 페이지로 이동합니다. (index.html에서 구현)`);
  // 미니 네비 활성화
  document.querySelectorAll('.mini-nav-btn').forEach(btn => btn.classList.remove('active'));
}

/* ========== 토스트 ========== */
function showToast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 2500);
}

/* ========== 초기화 ========== */
Storage.insertSampleData();
renderSidePanel();

// Enter키로 분석 실행
document.getElementById('jobInput').addEventListener('keydown', e => {
  if (e.ctrlKey && e.key === 'Enter') runAnalysis();
});
</script>
