    { pattern: /rust/i, name: 'Rust', cat: '언어', level: '심화', desc: '시스템 프로그래밍, 안전한 메모리 관리' },
    { pattern: /spring|spring boot/i, name: 'Spring Boot', cat: '프레임워크', level: '중급', desc: 'Java 백엔드 표준 프레임워크' },
    { pattern: /react/i, name: 'React', cat: '프레임워크', level: '입문', desc: '페이스북이 만든 UI 라이브러리' },
    { pattern: /vue/i, name: 'Vue.js', cat: '프레임워크', level: '입문', desc: '쉽게 배울 수 있는 프론트엔드 프레임워크' },
    { pattern: /angular/i, name: 'Angular', cat: '프레임워크', level: '중급', desc: '구글의 대규모 프론트엔드 프레임워크' },
    { pattern: /django/i, name: 'Django', cat: '프레임워크', level: '중급', desc: 'Python 백엔드 프레임워크' },
    { pattern: /flask/i, name: 'Flask', cat: '프레임워크', level: '입문', desc: 'Python 경량 웹 프레임워크' },
    { pattern: /fastapi/i, name: 'FastAPI', cat: '프레임워크', level: '중급', desc: 'Python 고성능 API 프레임워크' },
    { pattern: /node\.?js/i, name: 'Node.js', cat: '프레임워크', level: '중급', desc: 'JavaScript 백엔드 런타임' },
    { pattern: /mysql/i, name: 'MySQL', cat: 'DB', level: '입문', desc: '오픈소스 관계형 DB' },
    { pattern: /postgresql|postgres/i, name: 'PostgreSQL', cat: 'DB', level: '중급', desc: '고성능 오픈소스 관계형 DB' },
